<UserControl x:Class="SquadDns.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SquadDns.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource backups.title}" Style="{StaticResource Title.Text}" />
                <TextBlock Text="{DynamicResource about.privacy}" Style="{StaticResource Muted.Text}" Margin="0,4,0,0" MaxWidth="760" />
            </StackPanel>
            <Button Style="{StaticResource Primary.Button}" Content="{DynamicResource backups.create}"
                    Command="{Binding CreateBackupCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ListBox Style="{StaticResource Compact.ListBox}" ItemsSource="{Binding Backups}"
                     SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neon}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource Muted.Text}" Text="{Binding CreatedAt}" Margin="0,0,14,0" />
                                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.interface}" Margin="0,0,4,0" />
                                    <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding InterfaceAlias}" Margin="0,0,14,0" />
                                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.policy}" Margin="0,0,4,0" />
                                    <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding PolicyText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Mono.Text}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Servers}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Style="{StaticResource Primary.Button}" Content="{DynamicResource backups.restore}"
                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="0,0,0,4" />
                                <Button Style="{StaticResource Danger.Button}" Content="{DynamicResource backups.delete}"
                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Style="{StaticResource Card.Border}" Margin="14,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource backups.title}" Style="{StaticResource Section.Text}" />
                    <TextBlock Style="{StaticResource Body.Text}" Foreground="{DynamicResource Brush.TextMuted}"
                               Text="{DynamicResource backups.empty}" Margin="0,0,0,10"
                               Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisInverse}}" />
                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.interface}" />
                    <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding SelectedBackup.InterfaceAlias}" />
                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.servers}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding SelectedBackup.Servers}" />
                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.policy}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding SelectedBackup.PolicyText}" />
                    <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource backups.id}" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Mono.Text}" FontSize="11" Text="{Binding SelectedBackup.Id}" />
                    <Button Style="{StaticResource Ghost.Button}" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Content="{DynamicResource backups.export}" Command="{Binding ExportBackupCommand}"
                            IsEnabled="{Binding HasBackups}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
