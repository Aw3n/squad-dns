<UserControl x:Class="SquadDns.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SquadDns.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountVisible" />
    </UserControl.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource library.title}" Style="{StaticResource Title.Text}" />
            <TextBlock Text="{DynamicResource library.subtitle}" Style="{StaticResource Muted.Text}" Margin="0,2,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Border}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource library.mode.title}" Style="{StaticResource Section.Text}" />
                        <RadioButton Content="{DynamicResource library.mode.encOnly}" GroupName="mode"
                                     IsChecked="{Binding EncryptedOnlyChecked, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource library.mode.preferred}" GroupName="mode"
                                     IsChecked="{Binding EncryptedPreferredChecked, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource library.mode.plain}" GroupName="mode"
                                     IsChecked="{Binding UnencryptedChecked, Mode=TwoWay}" />

                        <CheckBox Content="{DynamicResource library.backupBefore}" Margin="0,12,0,0"
                                  IsChecked="{Binding AutoBackup, Mode=TwoWay}" />
                        <CheckBox Content="{DynamicResource library.dryRun}" Margin="0,4,0,0"
                                  IsChecked="{Binding PreviewOnly, Mode=TwoWay}" />
                        <CheckBox Content="{DynamicResource settings.dotUse}" Margin="0,4,0,0"
                                  IsChecked="{Binding UseDotAddresses, Mode=TwoWay}"
                                  Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card.Border}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource library.interface.title}" Style="{StaticResource Section.Text}" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource library.search}" />
                            <Button Grid.Column="2" Style="{StaticResource Ghost.Button}" Content="{DynamicResource status.refresh}"
                                    Command="{Binding RefreshCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ListBox Style="{StaticResource Compact.ListBox}"
                                     ItemsSource="{Binding Adapters}"
                                     SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                                <TextBlock Text="{Binding ServersText}" Style="{StaticResource Mono.Text}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Cyan}" Text="{Binding Adapter.State}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1" Text="{DynamicResource library.interface.hint}"
                                   Style="{StaticResource Muted.Text}" FontSize="11" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <ListBox Grid.Row="1" Style="{StaticResource Card.ListBox}"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource Font.Display}"
                                       Foreground="{DynamicResource Brush.Neon}" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="999"
                                    Background="{DynamicResource Brush.NeonDim}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Neon}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource library.current}" FontSize="10" Foreground="{DynamicResource Brush.Neon}" />
                            </Border>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Border Style="{StaticResource Chip.Border}" Visibility="{Binding ShowAds, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource library.tags.ads}" FontSize="11" Foreground="{DynamicResource Brush.Magenta}" />
                            </Border>
                            <Border Style="{StaticResource Chip.Border}" Visibility="{Binding ShowMalware, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource library.tags.malware}" FontSize="11" Foreground="{DynamicResource Brush.Amber}" />
                            </Border>
                            <Border Style="{StaticResource Chip.Border}" Visibility="{Binding ShowNonProfit, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource library.tags.nonprofit}" FontSize="11" Foreground="{DynamicResource Brush.Cyan}" />
                            </Border>
                            <Border Style="{StaticResource Chip.Border}" Visibility="{Binding ShowConfigId, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{DynamicResource library.tags.configId}" FontSize="11" Foreground="{DynamicResource Brush.Amber}" />
                            </Border>
                            <Border Style="{StaticResource Chip.Border}" Visibility="{Binding ShowSunset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SunsetText}" FontSize="11" Foreground="{DynamicResource Brush.Red}" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="{Binding Description}"
                                   Style="{StaticResource Body.Text}" Foreground="{DynamicResource Brush.TextMuted}" />

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{DynamicResource library.doh}" Style="{StaticResource Muted.Text}" Width="70" />
                                    <TextBlock Text="{Binding DoHTemplate}" Style="{StaticResource Mono.Text}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{DynamicResource library.dot}" Style="{StaticResource Muted.Text}" Width="70" />
                                    <TextBlock Text="{Binding DotEndpoint}" Style="{StaticResource Mono.Text}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource library.servers}" Style="{StaticResource Muted.Text}" Width="70" />
                                    <TextBlock Text="{Binding ServersText}" Style="{StaticResource Mono.Text}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding MedianDoH, StringFormat={}{0} ms}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" FontFamily="{DynamicResource Font.Data}"
                                           Foreground="{DynamicResource Brush.Cyan}"
                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource Ghost.Button}" Content="{DynamicResource library.test}"
                                        Command="{Binding DataContext.TestProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource Primary.Button}"
                                        Content="{DynamicResource library.apply}"
                                        ToolTip="{DynamicResource library.applyTip}"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Style="{StaticResource Card.Border}" Margin="0,14,0,0"
                Visibility="{Binding Steps.Count, Converter={StaticResource CountVisible}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource library.preview.title}" Style="{StaticResource Section.Text}" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Une grille et non un StackPanel horizontal : dans un StackPanel horizontal, la
                             colonne de commande est mesuree avec une largeur infinie, donc TextWrapping ne
                             sert jamais et les commandes longues sont coupees sans raison affichable. -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding State}" FontFamily="{DynamicResource Font.Data}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{DynamicResource Font.Data}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Command}" FontFamily="{DynamicResource Font.Data}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Cyan}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Error}" FontFamily="{DynamicResource Font.Data}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Red}" TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource library.preview.hint}" Style="{StaticResource Muted.Text}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
