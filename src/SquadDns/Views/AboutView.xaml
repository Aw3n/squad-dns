<UserControl x:Class="SquadDns.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource about.title}" Style="{StaticResource Title.Text}" />
            <TextBlock Text="{DynamicResource about.blurb}" Style="{StaticResource Body.Text}" Margin="0,8,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card.Border}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource about.version}" Style="{StaticResource Section.Text}" />
                        <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding VersionText}" />
                        <TextBlock Text="{DynamicResource about.os}" Style="{StaticResource Section.Text}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding OsText}" />
                        <TextBlock Style="{StaticResource Body.Text}" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" Text="{DynamicResource about.privacy}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card.Border}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource about.warningTitle}" Style="{StaticResource Section.Text}" />
                        <TextBlock Style="{StaticResource Body.Text}" Foreground="{DynamicResource Brush.Amber}"
                                   Text="{DynamicResource about.warningText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card.Border}" Margin="0,12,0,0"
                    BorderBrush="{DynamicResource Brush.BorderStrong}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource about.donateTitle}" Style="{StaticResource Section.Text}" />
                    <TextBlock Style="{StaticResource Body.Text}" Text="{DynamicResource about.donateText}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding DonationAddress, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontSize="12" Padding="10,8" />
                        <Button Grid.Column="1" Style="{StaticResource Primary.Button}" Margin="10,0,0,0"
                                Content="{DynamicResource about.copyAddress}"
                                ToolTip="{Binding DonationAddress}"
                                Command="{Binding CopyDonationCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Primary.Button}" Content="{DynamicResource about.swap}"
                                ToolTip="{Binding SwapUrl}" Command="{Binding OpenSwapCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Ghost.Button}" Content="{DynamicResource about.xelis}"
                                ToolTip="{Binding XelisUrl}" Command="{Binding OpenXelisCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
