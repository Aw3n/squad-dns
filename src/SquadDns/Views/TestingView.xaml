<UserControl x:Class="SquadDns.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SquadDns.Infrastructure">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountVisible" />
    </UserControl.Resources>

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource tests.title}" Style="{StaticResource Title.Text}" Margin="0,0,0,4" />

        <Border Grid.Row="1" Style="{StaticResource Card.Border}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource tests.domain}" Style="{StaticResource Muted.Text}" />
                    <TextBox Width="180" Margin="0,4,0,0" Text="{Binding TestDomain, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource tests.samples}" Style="{StaticResource Muted.Text}" />
                    <TextBox Width="70" Margin="0,4,0,0" Text="{Binding SampleCountText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource Primary.Button}" Content="{DynamicResource tests.run}"
                            Command="{Binding TestAllCommand}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Danger.Button}" Content="{DynamicResource tests.stop}"
                            Command="{Binding StopTestsCommand}" Visibility="{Binding TestsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Style="{StaticResource Muted.Text}" VerticalAlignment="Center" Margin="16,0"
                           Text="{DynamicResource tests.explain}" />

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" MinWidth="150">
                    <!-- ProgressBar.Value hérite du mode TwoWay de RangeBase : expliciter OneWay, TestProgress est en lecture seule. -->
                    <ProgressBar Value="{Binding TestProgress, Mode=OneWay}" Maximum="100" Height="6" />
                    <TextBlock Style="{StaticResource Mono.Text}" FontSize="11" Margin="0,4,0,0" Text="{Binding BestLine}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AllProfiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Border}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neon}" />
                                    <TextBlock Text="{DynamicResource tests.running}" Margin="6,0,0,0" FontSize="10"
                                               Foreground="{DynamicResource Brush.Cyan}"
                                               Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <ProgressBar Value="{Binding ScoreBar, Mode=OneWay}" Maximum="100" Height="8" />
                                    <TextBlock Style="{StaticResource Muted.Text}" FontSize="10" Margin="0,3,0,0" Text="{Binding TestSummary}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding MedianDoH}" FontFamily="{DynamicResource Font.Data}"
                                           Foreground="{DynamicResource Brush.Cyan}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding MedianDoT}" FontFamily="{DynamicResource Font.Data}"
                                           Foreground="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding MedianPlain}" FontFamily="{DynamicResource Font.Data}"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Note}" Style="{StaticResource Muted.Text}" FontSize="11"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource tests.doh}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource tests.dot}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource tests.plain}" />
            </StackPanel>
            <Button Style="{StaticResource Ghost.Button}" Content="{DynamicResource library.test}"
                    HorizontalAlignment="Right" Command="{Binding TestProfileCommand}"
                    CommandParameter="{Binding SelectedProfile}" />
        </Grid>
    </Grid>
</UserControl>
