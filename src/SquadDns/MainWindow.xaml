<Window x:Class="SquadDns.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SquadDns.Infrastructure"
        xmlns:controls="clr-namespace:SquadDns.Controls"
        xmlns:views="clr-namespace:SquadDns.Views"
        Title="{DynamicResource window.title}"
        Width="1220" Height="800" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextElement.FontFamily="{DynamicResource Font.Body}"
        FontSize="13"
        Icon="pack://application:,,,/Assets/icon.png">

    <Window.Resources>
        <conv:SectionVisibilityConverter x:Key="SectionVisible" />
        <conv:SectionButtonConverter x:Key="SectionChecked" />
        <conv:CountToVisibilityConverter x:Key="CountVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <controls:MatrixRain RainBrush="{DynamicResource Brush.Rain}" Run="{Binding RainEnabled}" />

        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="22,16,22,12"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource app.name}" Style="{StaticResource Title.Text}" Margin="0,0,12,0" />
                        <TextBlock Text="{DynamicResource app.tagline}" Style="{StaticResource Muted.Text}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip.Border}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElevationText}" FontSize="11"
                                       Foreground="{DynamicResource Brush.Amber}" />
                        </Border>

                        <ToggleButton Style="{StaticResource Segment.ToggleButton}" Content="FR" Margin="0,0,6,0"
                                      IsChecked="{Binding FrenchChecked, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource Segment.ToggleButton}" Content="EN" Margin="0,0,12,0"
                                      IsChecked="{Binding EnglishChecked, Mode=TwoWay}" />

                        <ToggleButton Style="{StaticResource Segment.ToggleButton}"
                                      Content="{DynamicResource settings.themeDark}" Margin="0,0,6,0"
                                      IsChecked="{Binding DarkChecked, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource Segment.ToggleButton}"
                                      Content="{DynamicResource settings.themeLight}"
                                      IsChecked="{Binding LightChecked, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="22,10"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource status.interface}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding InterfaceSummary}" Margin="0,0,18,0" />
                        <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource status.activeDns}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding ActiveServersLine}" MaxWidth="320" Margin="0,0,18,0" />
                        <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource status.policy}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Mono.Text}" Text="{Binding PolicyLine}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center"
                               Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body.Text}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLevelValue}" Value="Success">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusLevelValue}" Value="Warning">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusLevelValue}" Value="Error">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Style="{StaticResource Muted.Text}"
                               Text="{Binding VersionText, StringFormat=Squad DNS {0}}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Left" Width="196" Padding="10,16"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <ToggleButton Style="{StaticResource Segment.ToggleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  Content="{DynamicResource nav.library}"
                                  IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=0, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource Segment.ToggleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  Content="{DynamicResource nav.tests}"
                                  IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=1, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource Segment.ToggleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  Content="{DynamicResource nav.backups}"
                                  IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=2, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource Segment.ToggleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                  Content="{DynamicResource nav.settings}"
                                  IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=3, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource Segment.ToggleButton}" HorizontalAlignment="Stretch"
                                  Content="{DynamicResource nav.about}"
                                  IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=4, Mode=TwoWay}" />

                    <Border Margin="0,24,0,0" Style="{StaticResource Card.Border}" Padding="10"
                            Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted.Text}" Text="{DynamicResource elevation.banner}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource Primary.Button}" Content="{DynamicResource elevation.button}"
                                    Command="{Binding ElevateCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0">
                <views:LibraryView Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=0}" />
                <views:TestingView Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=1}" />
                <views:BackupsView Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=2}" />
                <views:SettingsView Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=3}" />
                <views:AboutView Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=4}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
