<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="Color.Window">#FFF4F8F7</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFE9F2EF</Color>
    <Color x:Key="Color.Neon">#FF007A55</Color>

    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF6FAF9" Offset="0" />
        <GradientStop Color="#FFEAF3F0" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#140B3B2E" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1F0B3B2E" />
    <SolidColorBrush x:Key="Brush.Border" Color="#33007A55" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#66007A55" />

    <SolidColorBrush x:Key="Brush.Text" Color="#FF10221C" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF557067" />
    <SolidColorBrush x:Key="Brush.TextInverse" Color="#FFF4FFFB" />

    <SolidColorBrush x:Key="Brush.Neon" Color="#FF007A55" />
    <SolidColorBrush x:Key="Brush.NeonDim" Color="#14007A55" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="#FF0A7C99" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#FFA26500" />
    <SolidColorBrush x:Key="Brush.Magenta" Color="#FFB3236E" />
    <SolidColorBrush x:Key="Brush.Red" Color="#FFB3261E" />
    <SolidColorBrush x:Key="Brush.Green" Color="#FF137A42" />

    <SolidColorBrush x:Key="Brush.NavSelected" Color="#22007A55" />
    <SolidColorBrush x:Key="Brush.Rain" Color="#11007A55" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#40007A55" />

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Data">Consolas, Cascadia Mono</FontFamily>

    <sys:Double x:Key="Size.Title">26</sys:Double>
    <sys:Double x:Key="Size.Section">16</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.Mono">12</sys:Double>

    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">999</CornerRadius>

</ResourceDictionary>
