<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="Color.Window">#FF03090A</Color>
    <Color x:Key="Color.Surface">#FF07141A</Color>
    <Color x:Key="Color.SurfaceAlt">#FF04101C</Color>
    <Color x:Key="Color.Neon">#FF22FF9C</Color>

    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF020809" Offset="0" />
        <GradientStop Color="#FF03141A" Offset="0.55" />
        <GradientStop Color="#FF061F1A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Surface" Color="#FF08151A" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3322FF9C" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#6622FF9C" />

    <SolidColorBrush x:Key="Brush.Text" Color="#FFE4FFF6" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF78B3A6" />
    <SolidColorBrush x:Key="Brush.TextInverse" Color="#FF04100E" />

    <SolidColorBrush x:Key="Brush.Neon" Color="#FF22FF9C" />
    <SolidColorBrush x:Key="Brush.NeonDim" Color="#1F22FF9C" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="#FF38E1FF" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#FFFFC24B" />
    <SolidColorBrush x:Key="Brush.Magenta" Color="#FFFF4D9E" />
    <SolidColorBrush x:Key="Brush.Red" Color="#FFFF5C5C" />
    <SolidColorBrush x:Key="Brush.Green" Color="#FF3DDC84" />

    <SolidColorBrush x:Key="Brush.NavSelected" Color="#2222FF9C" />
    <SolidColorBrush x:Key="Brush.Rain" Color="#5522FF9C" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#4022FF9C" />

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Data">Consolas, Cascadia Mono</FontFamily>

    <sys:Double x:Key="Size.Title">26</sys:Double>
    <sys:Double x:Key="Size.Section">16</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.Mono">12</sys:Double>

    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">999</CornerRadius>

</ResourceDictionary>
